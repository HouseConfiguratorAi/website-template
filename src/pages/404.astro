---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Arrow from '@/components/ui/Arrow.astro';
import Heading from '@/components/ui/Heading.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="nf" data-tone="dark">
    <div class="container container--gallery nf__inner">
      <p class="nf__label" data-intro="fade" style="--intro:150ms"><span class="t-index">(404)</span><span class="t-eyebrow">Page not found</span></p>
      <Heading as="h1" size="display" text="This road does not go *anywhere.*" reveal="load" delay={200} class="nf__title" />
      <p class="t-lead muted" data-intro style="--intro:400ms">The page may have moved, or the car it described has found a new home.</p>
      <div class="nf__actions" data-intro style="--intro:550ms">
        <a class="btn btn--primary" href="/vehicles">Explore the collection <Arrow /></a>
        <a class="btn btn--ghost" href="/">Back to the start</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 88svh;
    display: grid;
    align-items: end;
    padding-top: calc(var(--header-h) + var(--section-m));
    padding-bottom: var(--section-m);
  }
  .nf__inner {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .nf__label {
    display: flex;
    gap: 14px;
    align-items: baseline;
  }
  .nf__inner :global(.nf__title) {
    max-width: 9em;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
