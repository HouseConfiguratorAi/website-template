---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Arrow from '@/components/ui/Arrow.astro';
import Heading from '@/components/ui/Heading.astro';
---

<BaseLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet." noindex>
  <section class="nf" data-tone="dark">
    <div class="container container--gallery nf__inner">
      <p class="nf__label" data-intro="fade" style="--intro:150ms"><span class="t-index">404</span><span class="t-eyebrow">Pagina niet gevonden</span></p>
      <Heading as="h1" size="display" text="Deze weg loopt *dood.*" reveal="load" delay={200} class="nf__title" />
      <p class="t-lead muted" data-intro style="--intro:400ms">De pagina is misschien verplaatst, of de auto die hier stond heeft een nieuwe eigenaar gevonden.</p>
      <div class="nf__actions" data-intro style="--intro:550ms">
        <a class="btn btn--primary" href="/aanbod">Ontdek de collectie <Arrow /></a>
        <a class="btn btn--ghost" href="/">Terug naar home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 88svh;
    display: grid;
    align-items: end;
    padding-top: calc(var(--header-h) + var(--section-m));
    padding-bottom: var(--section-m);
  }
  .nf__inner {
    display: grid;
    gap: var(--s-6);
    justify-items: center;
    text-align: center;
  }
  .nf__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    align-items: baseline;
  }
  .nf__inner :global(.nf__title) {
    max-width: 9em;
  }
  .nf__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
