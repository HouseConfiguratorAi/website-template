---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import StorySection from '@/components/sections/StorySection.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import Media from '@/components/ui/Media.astro';
import { about } from '@/config/content';
import { pad } from '@/lib/format';
import Heading from '@/components/ui/Heading.astro';
import Label from '@/components/ui/Label.astro';
import { breadcrumbLd } from '@/lib/seo';
---

<BaseLayout title={about.seo.title} description={about.seo.description} image={about.image} jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }])}>
  <PageIntro eyebrow={about.eyebrow} headline={about.headline} lead={about.intro} />

  <section class="about-image" data-tone="dark" data-scene="through">
    <div class="about-image__frame media" data-reveal="image">
      <div class="about-image__drift"><Media src={about.image} alt={about.imageAlt} sizes="100vw" focal="45% 55%" /></div>
    </div>
  </section>

  <section class="principles" data-tone="light">
    <div class="container container--gallery">
      <Label text="What we believe" index="01" />
      <ol class="principles__list" role="list">
        {
          about.principles.map((p, i) => (
            <li data-reveal style={`--delay:${(i % 2) * 100}ms`}>
              <span class="t-index">{pad(i + 1)}</span>
              <Heading as="h2" size="title" text={p.title} />
              <p class="t-body muted">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <StorySection
    layout="left"
    tone="dark"
    eyebrow={about.space.eyebrow}
    headline={about.space.headline}
    body={[about.space.body]}
    cta={{ label: 'Plan a visit', href: '/contact' }}
    image={about.space.image}
    imageAlt={about.space.imageAlt}
    size="narrow"
  />

  <FinalCTA />
</BaseLayout>

<style>
  .about-image {
    padding-bottom: var(--section-m);
  }
  .about-image__frame {
    width: min(100% - 2 * var(--gutter), var(--w-gallery));
    margin-inline: auto;
    aspect-ratio: 21 / 9;
  }
  .about-image__drift {
    height: 112%;
    margin-top: -6%;
    transform: translate3d(0, calc((var(--p, 0.5) - 0.5) * -10%), 0);
  }
  .principles {
    padding-block: var(--section-l);
  }
  .principles__list {
    margin-top: var(--section-s);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--section-s) var(--gutter);
  }
  .principles__list li {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
    max-width: 34rem;
  }
  .principles__list li:nth-child(even) {
    margin-top: var(--s-10);
  }
  @media (max-width: 47.99rem) {
    .about-image__frame {
      aspect-ratio: 4 / 5;
    }
    .principles__list {
      grid-template-columns: 1fr;
    }
    .principles__list li:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
