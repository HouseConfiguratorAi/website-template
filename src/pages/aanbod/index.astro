---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VehicleCard from '@/components/vehicles/VehicleCard.astro';
import VehicleFilters from '@/components/vehicles/VehicleFilters.astro';
import Heading from '@/components/ui/Heading.astro';
import { getListedVehicles } from '@/lib/inventory';
import { breadcrumbLd } from '@/lib/seo';
import { site } from '@/config/site';
import { formatDate } from '@/lib/format';

const vehicles = await getListedVehicles();
const count = vehicles.length;
const updated = vehicles.map((v) => v.listed).filter(Boolean).sort().at(-1);
const words = ['Geen', 'Eén', 'Twee', 'Drie', 'Vier', 'Vijf', 'Zes', 'Zeven', 'Acht', 'Negen', 'Tien', 'Elf', 'Twaalf'];
const countWord = words[count] ?? String(count);
---

<BaseLayout
  title="Aanbod"
  description={`${countWord} geselecteerde sport- en GT-auto’s bij ${site.name} in Amsterdam. Gekeurd, gedocumenteerd en gefotografeerd.`}
  image="journal-collection"
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Aanbod', path: '/aanbod' }])}
>
  <section class="inv-intro" data-tone="dark">
    <div class="container inv-intro__inner">
      <p class="inv-intro__label" data-intro="fade" style="--intro:150ms">
        <span class="t-eyebrow">De collectie</span>
        <span class="t-meta muted">{count} auto’s{updated && ` · Bijgewerkt ${formatDate(new Date(updated))}`}</span>
      </p>
      <Heading as="h1" size="display" text={`${countWord} auto’s. *Elk* bewust gekozen.`} reveal="load" delay={200} class="inv-intro__title" />
      <p class="t-lead inv-intro__lead" data-intro style="--intro:400ms">
        Elke auto op deze pagina is gekeurd, gedocumenteerd en staat in de showroom. Vraag van elke auto het volledige dossier op.
      </p>
    </div>
  </section>

  <section class="inv" data-tone="dark" aria-label="Auto’s">
    <VehicleFilters vehicles={vehicles} />

    <div class="container container--gallery">
      <ul class="inv__results" role="list" data-results>
        {
          vehicles.map((v, i) => (
            <li
              class="inv__item"
              data-vehicle
              data-make={v.brand}
              data-model={v.model}
              data-body={v.bodyType}
              data-fuel={v.fuel}
              data-transmission={v.transmission}
              data-price={v.price ?? ''}
              data-year={v.year}
              data-mileage={v.mileage}
              data-order={i}
              data-photo={v.images.length ? '' : undefined}
              data-search={`${v.brand} ${v.model} ${v.variant ?? ''} ${v.year} ${v.exteriorColor} ${v.bodyType} ${v.fuel}`.toLowerCase()}
            >
              <VehicleCard vehicle={v} ratio="3 / 2" sizes="(min-width: 64rem) 50vw, 100vw" headingLevel="h2" />
            </li>
          ))
        }
      </ul>

      <div class="inv__empty" data-empty hidden>
        <p class="t-title">Geen auto’s gevonden.</p>
        <p class="t-body muted">Probeer minder filters — of vertel ons wat u zoekt, dan gaan wij op zoek.</p>
        <div class="inv__empty-actions">
          <button class="btn btn--primary" type="button" data-clear>Wis filters</button>
          <a class="link-arrow" href="/contact">Laat ons zoeken</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .inv-intro {
    padding-top: calc(var(--header-h) + var(--section-m));
    padding-bottom: var(--section-s);
  }

  .inv-intro__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-6);
    text-align: center;
  }

  .inv-intro__label {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .inv-intro__inner > :global(.inv-intro__title) {
    max-width: 12ch;
    font-size: clamp(2.8rem, 1rem + 6.4vw, 8rem);
  }

  .inv-intro__lead {
    max-width: 30em;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
  }

  .inv {
    padding-bottom: var(--section-l);
  }

  .inv__results {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-9) var(--gutter);
  }

  /* Every fifth visible car takes the full width — a pause in the catalogue. */
  .inv__item[data-photo]:nth-child(5n + 1 of :not([hidden])) {
    grid-column: 1 / -1;
  }

  .inv__item[data-photo]:nth-child(5n + 1 of :not([hidden])) :global(.vcard__media) {
    aspect-ratio: 21 / 9 !important;
  }

  .inv__item[hidden] {
    display: none;
  }

  .inv__empty {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    padding-block: var(--section-m);
    max-width: 40rem;
  }

  .inv__empty[hidden] {
    display: none;
  }

  .inv__empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-6);
    margin-top: var(--s-4);
  }

  @media (max-width: 47.99rem) {
    .inv__results {
      grid-template-columns: 1fr;
      row-gap: var(--s-8);
    }
    .inv__item[data-photo]:nth-child(5n + 1 of :not([hidden])) :global(.vcard__media) {
      aspect-ratio: 4 / 3 !important;
    }
  }
</style>
