---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import JournalCard from '@/components/sections/JournalCard.astro';
import { getJournalLayout } from '@/lib/journal';
import { breadcrumbLd } from '@/lib/seo';

const { feature, rest } = await getJournalLayout();
---

<BaseLayout
  title="Magazine"
  description="Essays, gidsen en verhalen uit de werkplaats — over auto’s die het kennen waard zijn en hoe u er een kiest."
  image={feature.data.cover}
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Magazine', path: '/magazine' }])}
>
  <PageIntro eyebrow="Magazine" headline="Over auto’s die het *kennen waard* zijn." size="display" />

  <section class="jfeature" data-tone="dark">
    <div class="container container--gallery">
      <JournalCard post={feature} variant="feature" headingLevel="h2" />
    </div>
  </section>

  <section class="jlist" data-tone="light" aria-label="Meer artikelen">
    <div class="container container--gallery">
      <ul class="jlist__grid" role="list">
        {rest.map((p, i) => <li><JournalCard post={p} variant="grid" headingLevel="h2" delay={(i % 3) * 90} /></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .jfeature {
    padding-bottom: var(--section-l);
  }
  .jfeature :global(.jcard--feature .jcard__link) {
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    column-gap: var(--gutter);
    align-items: end;
  }
  .jlist {
    padding-block: var(--section-l);
  }
  .jlist__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-9) var(--gutter);
  }
  .jlist__grid li:nth-child(3n + 2) {
    margin-top: var(--s-10);
  }
  @media (max-width: 63.99rem) {
    .jfeature :global(.jcard--feature .jcard__link) {
      grid-template-columns: 1fr;
    }
    .jlist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .jlist__grid li:nth-child(n) {
      margin-top: 0;
    }
  }
  @media (max-width: 47.99rem) {
    .jlist__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
