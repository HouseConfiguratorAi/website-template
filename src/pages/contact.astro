---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import LocationSection from '@/components/sections/LocationSection.astro';
import { contact } from '@/config/site';
import { dealerLd, breadcrumbLd } from '@/lib/seo';
---

<BaseLayout
  title="Contact"
  description={`Bezoek de showroom in ${contact.address.city}, bel ${contact.phone} of stuur ons een bericht.`}
  image="location-hall"
  jsonLd={[dealerLd(), breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]}
>
  <PageIntro eyebrow="Contact" headline="Op zoek naar iets *bijzonders?*" lead="Vraag naar een auto uit de collectie, een auto die er niet in staat, of alles daartussen. We antwoorden persoonlijk, meestal dezelfde dag nog." />
  <ContactSection eyebrow="Schrijf ons" headline="Begin met een *bericht.*" body="Of bel ons tijdens openingstijden. Bezichtigingen buiten die tijden zijn mogelijk op afspraak." />
  <LocationSection />
</BaseLayout>
