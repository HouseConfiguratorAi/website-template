---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VehicleCard from '@/components/vehicles/VehicleCard.astro';
import VehicleFilters from '@/components/vehicles/VehicleFilters.astro';
import Heading from '@/components/ui/Heading.astro';
import { getListedVehicles } from '@/lib/inventory';
import { breadcrumbLd } from '@/lib/seo';
import { site } from '@/config/site';

const vehicles = await getListedVehicles();
const count = vehicles.length;
const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const countWord = words[count] ?? String(count);
---

<BaseLayout
  title="Vehicles"
  description={`${countWord} selected sports and grand touring cars at ${site.name}. Inspected, documented and photographed.`}
  image="journal-collection"
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Vehicles', path: '/vehicles' }])}
>
  <section class="inv-intro" data-tone="dark">
    <div class="container container--gallery inv-intro__grid">
      <p class="inv-intro__label eyebrow-row" data-intro="fade" style="--intro:150ms"><span class="t-eyebrow">The collection</span><span class="t-meta muted">{count} listed</span></p>
      <Heading as="h1" size="display" text={`${countWord} cars. *Each* one chosen.`} reveal="load" delay={200} class="inv-intro__title" />
      <p class="t-lead inv-intro__lead" data-intro style="--intro:400ms">
        Every car on this page is inspected, documented and in the showroom. Ask for the full file on any of them.
      </p>
    </div>
  </section>

  <section class="inv" data-tone="dark" aria-label="Vehicles">
    <VehicleFilters vehicles={vehicles} />

    <div class="container container--gallery">
      <ul class="inv__results" role="list" data-results>
        {
          vehicles.map((v, i) => (
            <li
              class="inv__item"
              data-vehicle
              data-make={v.brand}
              data-model={v.model}
              data-body={v.bodyType}
              data-fuel={v.fuel}
              data-transmission={v.transmission}
              data-price={v.price ?? ''}
              data-year={v.year}
              data-mileage={v.mileage}
              data-order={i}
              data-photo={v.images.length ? '' : undefined}
              data-search={`${v.brand} ${v.model} ${v.variant ?? ''} ${v.year} ${v.exteriorColor} ${v.bodyType} ${v.fuel}`.toLowerCase()}
            >
              <VehicleCard vehicle={v} ratio="3 / 2" sizes="(min-width: 64rem) 50vw, 100vw" headingLevel="h2" />
            </li>
          ))
        }
      </ul>

      <div class="inv__empty" data-empty hidden>
        <p class="t-title">No vehicles match your search.</p>
        <p class="t-body muted">Try fewer filters — or tell us what you are looking for and we will find it.</p>
        <div class="inv__empty-actions">
          <button class="btn btn--primary" type="button" data-clear>Clear filters</button>
          <a class="link-arrow" href="/contact">Ask us to search</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .inv-intro {
    padding-top: calc(var(--header-h) + var(--section-m));
    padding-bottom: var(--section-s);
  }

  .inv-intro__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-6);
    align-items: end;
  }

  .inv-intro__label {
    grid-column: 1 / -1;
    color: var(--fg);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--border);
  }

  .inv-intro__label .t-meta {
    margin-left: auto;
  }

  .inv-intro__grid > :global(.inv-intro__title) {
    grid-column: 1 / span 8;
    font-size: clamp(3rem, 1rem + 7.4vw, 9rem);
  }

  .inv-intro__lead {
    grid-column: 9 / -1;
    padding-bottom: 0.6em;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
  }

  .inv {
    padding-bottom: var(--section-l);
  }

  .inv__results {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-9) var(--gutter);
  }

  /* Every fifth visible car takes the full width — a pause in the catalogue. */
  .inv__item[data-photo]:nth-child(5n + 1 of :not([hidden])) {
    grid-column: 1 / -1;
  }

  .inv__item[data-photo]:nth-child(5n + 1 of :not([hidden])) :global(.vcard__media) {
    aspect-ratio: 21 / 9 !important;
  }

  .inv__item[hidden] {
    display: none;
  }

  .inv__empty {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    padding-block: var(--section-m);
    max-width: 40rem;
  }

  .inv__empty[hidden] {
    display: none;
  }

  .inv__empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-6);
    margin-top: var(--s-4);
  }

  @media (max-width: 63.99rem) {
    .inv-intro__grid > :global(.inv-intro__title),
    .inv-intro__lead {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .inv__results {
      grid-template-columns: 1fr;
      row-gap: var(--s-8);
    }
    .inv__item[data-photo]:nth-child(5n + 1 of :not([hidden])) :global(.vcard__media) {
      aspect-ratio: 4 / 3 !important;
    }
  }
</style>
