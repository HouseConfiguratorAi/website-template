---
/**
 * Optional desktop cursor companion. The system cursor stays visible;
 * this only adds a small ring that becomes a label ("View", "Drag") over
 * elements with data-cursor. Disabled on touch devices and reduced motion.
 */
---
<div class="cursor" aria-hidden="true"><span class="cursor__label"></span></div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-cursor);
    width: 76px;
    height: 76px;
    margin: -38px 0 0 -38px;
    display: none;
    place-items: center;
    border-radius: 50%;
    pointer-events: none;
    background: var(--dark-accent);
    color: var(--dark-accent-contrast);
    opacity: 0;
    scale: 0.2;
    transition:
      opacity 250ms var(--ease-standard),
      scale 450ms var(--ease-emphasis);
    will-change: transform;
  }
  .cursor__label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    font-stretch: 118%;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  :global(.motion) .cursor.is-enabled {
    display: grid;
  }
  .cursor.is-active {
    opacity: 1;
    scale: 1;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.cursor');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (el && fine && document.documentElement.classList.contains('motion')) {
    const label = el.querySelector<HTMLElement>('.cursor__label')!;
    el.classList.add('is-enabled');
    let x = -100, y = -100, cx = x, cy = y, raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.22;
      cy += (y - cy) * 0.22;
      el.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.3 ? requestAnimationFrame(loop) : 0;
    };
    window.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      const target = (e.target as Element | null)?.closest<HTMLElement>('[data-cursor]');
      if (target) {
        label.textContent = target.dataset.cursor || '';
        el.classList.add('is-active');
      } else {
        el.classList.remove('is-active');
      }
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
    document.addEventListener('pointerleave', () => el.classList.remove('is-active'));
  }
</script>
