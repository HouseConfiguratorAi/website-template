---
import { rich } from '@/lib/text';
import Arrow from '@/components/ui/Arrow.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  body?: string;
  cta?: { label: string; href: string };
  as?: 'h1' | 'h2';
  size?: 'headline' | 'title' | 'display';
  class?: string;
  /** Put body/cta beside the headline on wide screens. */
  split?: boolean;
}

const { eyebrow, headline, body, cta, as: Tag = 'h2', size = 'headline', class: className, split = false } = Astro.props;
---

<header class:list={['shead', { 'shead--split': split }, className]}>
  <div class="shead__main">
    {eyebrow && <p class="t-eyebrow eyebrow-row" data-reveal="fade">{eyebrow}</p>}
    <Tag class={`t-${size}`} data-reveal set:html={rich(headline)} />
  </div>
  {
    (body || cta) && (
      <div class="shead__aside" data-reveal style="--delay:120ms">
        {body && <p class="t-body muted">{body}</p>}
        {cta && (
          <a class="link-arrow" href={cta.href}>
            {cta.label}
            <Arrow />
          </a>
        )}
      </div>
    )
  }
</header>

<style>
  .shead {
    display: grid;
    gap: var(--s-6);
  }
  .shead__main {
    display: grid;
    gap: var(--s-5);
  }
  .shead__aside {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    max-width: 30rem;
  }
  @media (min-width: 64rem) {
    .shead--split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
      column-gap: var(--gutter);
    }
    .shead--split .shead__aside {
      padding-bottom: 0.6em;
    }
  }
</style>
