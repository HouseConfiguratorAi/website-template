---
/** The closing scene: one image, one line, one way forward. */
import { home } from '@/config/content';
import { rich } from '@/lib/text';
import Media from '@/components/ui/Media.astro';
import Arrow from '@/components/ui/Arrow.astro';

interface Props {
  headline?: string;
  cta?: { label: string; href: string };
  image?: string;
  imageAlt?: string;
}
const f = home.final;
const { headline = f.headline, cta = f.cta, image = f.image, imageAlt = f.imageAlt } = Astro.props;
---

<section class="final" data-tone="dark" data-scene="enter">
  <div class="final__media">
    <div class="final__zoom"><Media src={image} alt={imageAlt} sizes="100vw" focal="55% 55%" /></div>
  </div>
  <div class="final__veil" aria-hidden="true"></div>
  <div class="final__content container container--gallery">
    <h2 class="t-headline final__title" data-reveal set:html={rich(headline)} />
    <a class="btn btn--primary" href={cta.href} data-reveal style="--delay:150ms">{cta.label}<Arrow /></a>
  </div>
</section>

<style>
  .final {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: clip;
    isolation: isolate;
  }
  .final__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .final__zoom {
    height: 100%;
    transform: scale(calc(1.12 - var(--p, 1) * 0.12));
    will-change: transform;
  }
  .final__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(8 8 8 / 0.8), rgb(8 8 8 / 0.1) 55%, rgb(8 8 8 / 0.3));
  }
  .final__content {
    padding-block: var(--section-m);
    display: grid;
    justify-items: start;
    gap: var(--s-7);
  }
  .final__title {
    max-width: 7.5em;
  }
</style>
