---
import { contact } from '@/config/site';
import Heading from '@/components/ui/Heading.astro';
import Label from '@/components/ui/Label.astro';
import ContactForm from '@/components/sections/ContactForm.astro';

interface Props {
  eyebrow: string;
  index?: string;
  headline: string;
  tone?: 'light' | 'dark' | 'signal';
  body?: string;
  vehicle?: string;
  headingLevel?: 'h1' | 'h2';
  id?: string;
}
const { eyebrow, index, headline, body, vehicle, headingLevel: H = 'h2', id = 'enquire', tone = 'light' } = Astro.props;
---

<section class="contact" data-tone={tone} id={id}>
  <div class="container container--gallery contact__grid">
    <div class="contact__intro">
      <Label text={eyebrow} index={index} />
      <Heading as={H} size="headline" text={headline} />
      {body && <p class="t-lead contact__body" data-reveal>{body}</p>}
      <div class="contact__direct t-small" data-reveal>
        <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
        <a class="link" href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
      </div>
    </div>
    <div class="contact__form" data-reveal style="--delay:120ms">
      <ContactForm vehicle={vehicle} idPrefix={id} />
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-l);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-8);
  }
  .contact__intro {
    grid-column: 1 / span 5;
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .contact__body {
    max-width: 24em;
  }
  .contact__direct {
    display: grid;
    justify-items: start;
    gap: 4px;
    margin-top: var(--s-5);
  }
  .contact__form {
    grid-column: 7 / -1;
    padding-top: var(--s-4);
  }
  @media (max-width: 63.99rem) {
    .contact__intro,
    .contact__form {
      grid-column: 1 / -1;
    }
  }
</style>
