---
/**
 * Vertical editorial list. Hovering (or focusing) a service swaps the image.
 * On touch screens the image follows the service in the middle of the viewport.
 */
import { services } from '@/data/services';
import { pad } from '@/lib/format';
import Media from '@/components/ui/Media.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Arrow from '@/components/ui/Arrow.astro';

interface Props {
  eyebrow?: string;
  index?: string;
  headline?: string;
  cta?: { label: string; href: string };
  /** Link each row to its section on /diensten. */
  linkRows?: boolean;
}
const { eyebrow, index, headline, cta, linkRows = true } = Astro.props;
---

<section class="services" data-tone="light" data-services>
  <div class="container container--gallery services__grid">
    {headline && <SectionHead class="services__head" align="split" eyebrow={eyebrow} index={index} meta={`${services.length} diensten`} headline={headline} cta={cta} />}

    <div class="services__visual" aria-hidden="true">
      <div class="services__frame media">
        {
          services.map((s, i) => (
            <div class="services__img" data-index={i} data-active={i === 0 ? '' : undefined}>
              <Media src={s.image} alt="" sizes="(min-width: 64rem) 40vw, 100vw" />
            </div>
          ))
        }
      </div>
      <p class="services__caption t-caption" data-caption>{services[0].imageAlt}</p>
    </div>

    <ol class="services__list" role="list">
      {
        services.map((s, i) => {
          const Row = linkRows ? 'a' : 'div';
          return (
            <li class="services__item" data-index={i} data-active={i === 0 ? '' : undefined} data-alt={s.imageAlt}>
              <Row class="services__row" href={linkRows ? `/diensten#${s.slug}` : undefined}>
                <span class="t-index">{pad(i + 1)}</span>
                <span class="services__title">{s.title}</span>
                <span class="services__summary t-small">{s.summary}</span>
                {linkRows && <Arrow class="services__arrow" />}
              </Row>
            </li>
          );
        })
      }
    </ol>

  </div>
</section>

<style>
  .services {
    padding-block: var(--section-l);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-8);
  }

  .services :global(.services__head) {
    grid-column: 1 / -1;
  }

  .services__visual {
    grid-column: 1 / span 5;
    grid-row: 2 / span 2;
    align-self: start;
    position: sticky;
    top: calc(var(--sticky-top) + var(--s-6));
    transition: top 600ms var(--ease-emphasis);
    display: grid;
    gap: var(--s-4);
  }

  .services__frame {
    aspect-ratio: 4 / 5;
  }

  .services__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 700ms var(--ease-standard),
      transform 1400ms var(--ease-emphasis);
  }

  .services__img[data-active] {
    opacity: 1;
    transform: none;
  }

  .services__list {
    grid-column: 7 / -1;
    grid-row: 2;
    border-top: 1px solid var(--border);
  }

  .services__item {
    border-bottom: 1px solid var(--border);
  }

  .services__row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: baseline;
    column-gap: var(--s-4);
    row-gap: var(--s-2);
    padding-block: clamp(22px, 1rem + 1.4vw, 40px);
    padding-left: 18px;
  }

  .services__title {
    font-family: var(--font-display);
    text-transform: var(--display-case, none);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    line-height: 1.02;
    transition:
      transform var(--dur-standard) var(--ease-emphasis),
      color var(--dur-micro) var(--ease-standard);
  }

  .services__summary {
    grid-column: 2;
    color: var(--muted);
    max-width: 34rem;
  }

  .services__row :global(.services__arrow) {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
    opacity: 0.4;
  }

  /* Non-active rows recede so the active one reads as selected. */
  .services__list:has([data-active]) .services__item:not([data-active]) .services__title {
    color: color-mix(in srgb, var(--fg) 62%, var(--bg));
  }

  .services__item[data-active] .services__title {
    transform: translateX(10px);
  }

  /* Active marker: a red bar at the start of the row. */
  .services__row::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform 600ms var(--ease-emphasis);
  }

  .services__item[data-active] .services__row::before {
    transform: scaleY(1);
  }

  .services__item[data-active] :global(.services__arrow) {
    opacity: 1;
  }


  @media (max-width: 63.99rem) {
    .services__visual {
      grid-column: 1 / -1;
      grid-row: auto;
      position: sticky;
      top: calc(var(--sticky-top) + 8px);
      z-index: 1;
    }
    .services__frame {
      aspect-ratio: 16 / 10;
    }
    .services__caption {
      display: none;
    }
    .services__list {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .services__row {
      grid-template-columns: 2.5rem 1fr;
    }
    .services__row :global(.services__arrow) {
      display: none;
    }
  }

  /* Phones: a shorter sticky frame and denser rows, so image and text share the screen. */
  @media (max-width: 47.99rem) {
    .services__grid {
      row-gap: var(--s-6);
    }
    .services__frame {
      aspect-ratio: 16 / 9;
    }
    .services__row {
      grid-template-columns: 1fr;
      padding-block: 18px;
      padding-left: 14px;
    }
    .services__row .t-index {
      display: none;
    }
    .services__summary {
      grid-column: 1;
    }
    .services__title {
      font-size: 1.625rem;
    }
    .services__item[data-active] .services__title {
      transform: translateX(4px);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-services]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.services__item')];
    const imgs = [...root.querySelectorAll<HTMLElement>('.services__img')];
    const caption = root.querySelector<HTMLElement>('[data-caption]');
    const activate = (index: number) => {
      items.forEach((el, i) => el.toggleAttribute('data-active', i === index));
      imgs.forEach((el, i) => el.toggleAttribute('data-active', i === index));
      if (caption) caption.textContent = items[index]?.dataset.alt ?? '';
    };
    items.forEach((item, i) => {
      item.addEventListener('pointerenter', () => activate(i));
      item.addEventListener('focusin', () => activate(i));
    });
    // Touch / narrow screens: the row crossing the middle of the viewport wins.
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) activate(items.indexOf(e.target as HTMLElement));
        },
        { rootMargin: '-45% 0px -45% 0px' },
      );
      items.forEach((el) => io.observe(el));
    }
  });
</script>
