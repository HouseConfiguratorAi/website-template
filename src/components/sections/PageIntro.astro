---
/** Typographic opening scene for inner pages. */
import Heading from '@/components/ui/Heading.astro';
interface Props {
  eyebrow: string;
  headline: string;
  lead?: string;
  size?: 'display' | 'headline' | 'title';
}
const { eyebrow, headline, lead, size = 'display' } = Astro.props;
---

<section class="intro" data-tone="dark">
  <div class="container intro__inner">
    <p class="intro__label t-eyebrow" data-intro="fade" style="--intro:150ms">{eyebrow}</p>
    <Heading as="h1" size={size} text={headline} reveal="load" delay={200} class="intro__title" />
    {lead && <p class="t-lead intro__lead" data-intro style="--intro:400ms">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .intro {
    padding-top: calc(var(--header-h) + var(--section-m));
    padding-bottom: var(--section-m);
  }
  /* Centred opening, like a model page: label, a red rule, the title, one paragraph. */
  .intro__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-6);
    text-align: center;
  }
  .intro__label {
    display: grid;
    justify-items: center;
    gap: 16px;
    color: var(--muted);
  }
  .intro__label::after {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--accent);
  }
  .intro__inner > :global(.intro__title) {
    max-width: 14ch;
  }
  .intro__lead {
    max-width: 32em;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
  }
</style>
