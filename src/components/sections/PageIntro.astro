---
/** Typographic opening scene for inner pages. */
import Heading from '@/components/ui/Heading.astro';
interface Props {
  eyebrow: string;
  headline: string;
  lead?: string;
  size?: 'display' | 'headline';
}
const { eyebrow, headline, lead, size = 'display' } = Astro.props;
---

<section class="intro" data-tone="dark">
  <div class="container container--gallery intro__grid">
    <p class="intro__label eyebrow-row" data-intro="fade" style="--intro:150ms"><span class="t-eyebrow">{eyebrow}</span></p>
    <Heading as="h1" size={size} text={headline} reveal="load" delay={200} class="intro__title" />
    {lead && <p class="t-lead intro__lead" data-intro style="--intro:400ms">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .intro {
    padding-top: calc(var(--header-h) + var(--section-m));
    padding-bottom: var(--section-m);
  }
  .intro__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-6);
    align-items: end;
  }
  .intro__grid > :global(*) {
    grid-column: 1 / -1;
  }
  .intro__label {
    color: var(--fg);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--border);
  }
  .intro__grid > :global(.intro__title) {
    grid-column: 1 / span 10;
    max-width: 10em;
  }
  .intro__lead {
    grid-column: 1 / span 6;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
    max-width: 30em;
  }
  @media (max-width: 63.99rem) {
    .intro__grid > :global(.intro__title),
    .intro__lead {
      grid-column: 1 / -1;
    }
  }
</style>
