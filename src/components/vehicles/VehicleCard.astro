---
import type { Vehicle } from '@/lib/inventory';
import { coverImage, imageOfKind, statusLabel, vehicleUrl } from '@/lib/inventory';
import { formatMileage, formatPrice, toPk } from '@/lib/format';
import Media from '@/components/ui/Media.astro';
import Arrow from '@/components/ui/Arrow.astro';

interface Props {
  vehicle: Vehicle;
  /** CSS aspect-ratio of the image, e.g. '3 / 2', '4 / 5'. */
  ratio?: string;
  /** Which photograph to use. Portrait frames work best with the 'portrait' shot. */
  image?: 'cover' | 'portrait' | 'profile';
  sizes?: string;
  size?: 'large' | 'medium' | 'small';
  /** Shared-element transition into the detail page. Only one per page per vehicle. */
  transition?: boolean;
  headingLevel?: 'h2' | 'h3';
  class?: string;
  delay?: number;
  /** Optional position shown as (01) — for curated, fixed-order selections. */
  index?: number;
}

const {
  vehicle: v,
  ratio = '3 / 2',
  image = 'cover',
  sizes = '(min-width: 64rem) 50vw, 100vw',
  size = 'medium',
  transition = true,
  headingLevel: H = 'h3',
  class: className,
  delay = 0,
  index,
} = Astro.props;

const img = (image !== 'cover' && imageOfKind(v, image)) || coverImage(v);
const url = vehicleUrl(v);
const flagged = v.status !== 'available';
---

<article class:list={['vcard', `vcard--${size}`, className]} data-reveal style={`--delay:${delay}ms`}>
  <a class="card-link" href={url} data-cursor="Bekijk">
    <div class="vcard__media media" style={`aspect-ratio:${ratio}`}>
      <Media
        src={img?.src}
        alt={img?.alt ?? ''}
        focal={img?.focal}
        sizes={sizes}
        transitionName={transition ? `vehicle-${v.slug}` : undefined}
      />
      {flagged && <span class="vcard__flag t-meta status-dot" data-status={v.status}>{statusLabel[v.status]}</span>}
    </div>
    <div class="vcard__body">
      <p class="vcard__top t-meta">
        <span class="vcard__brand">
          {index != null && <span class="t-index">{String(index).padStart(2, '0')}</span>}
          <span>{v.brand}</span>
        </span>
        <span class="muted">{v.year}</span>
      </p>
      <H class="vcard__title">{v.model}</H>
      {v.variant && <p class="vcard__variant">{v.variant}</p>}
      <dl class="vcard__meta">
        <div><dt class="sr-only">Kilometerstand</dt><dd>{formatMileage(v.mileage)}</dd></div>
        <div><dt class="sr-only">Vermogen</dt><dd>{toPk(v.power)} pk</dd></div>
        <div><dt class="sr-only">Transmissie</dt><dd>{v.transmission}</dd></div>
      </dl>
      <div class="vcard__foot">
        <p class="vcard__price"><span class="sr-only">Prijs: </span>{v.status === 'sold' ? 'Verkocht' : formatPrice(v.price)}</p>
        <span class="vcard__more" aria-hidden="true">Ontdek <Arrow /></span>
      </div>
    </div>
  </a>
</article>

<style>
  .vcard {
    position: relative;
    min-width: 0;
  }

  .card-link {
    display: grid;
    gap: var(--s-5);
  }

  .vcard__media {
    isolation: isolate;
  }

  /* A line of brand colour draws along the base of the image on hover. */
  .vcard__media::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 700ms var(--ease-emphasis);
  }

  .card-link:hover .vcard__media::after {
    transform: scaleX(1);
  }

  .vcard__media :global(img) {
    transition: transform 1400ms var(--ease-emphasis);
  }

  .card-link:hover .vcard__media :global(img) {
    transform: scale(1.04);
  }

  .vcard__flag {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 8px 12px;
    background: color-mix(in srgb, var(--dark-bg) 78%, transparent);
    color: var(--dark-fg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .vcard__body {
    display: grid;
    gap: 8px;
  }

  .vcard__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
  }

  .vcard__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  .vcard__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case, none);
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.25rem);
    line-height: 1;
  }

  .vcard--large .vcard__title {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 3rem);
  }

  .vcard--small .vcard__title {
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.75rem);
  }

  .vcard__variant {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .vcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin-top: 4px;
    font-size: var(--fs-caption);
    color: var(--muted);
  }

  .vcard__meta div {
    display: flex;
    align-items: center;
  }

  .vcard__meta dd {
    margin: 0;
    white-space: nowrap;
  }

  .vcard__meta div + div::before {
    content: '';
    width: 1px;
    height: 0.9em;
    margin-inline: 12px;
    background: color-mix(in srgb, var(--fg) 25%, transparent);
  }

  .vcard__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px var(--s-4);
    margin-top: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }

  .vcard__price {
    font-weight: 500;
    font-size: var(--fs-body);
    letter-spacing: -0.005em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .vcard__more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--dur-micro) var(--ease-standard);
  }

  .vcard__more :global(.arrow) {
    width: 16px;
    color: var(--accent-ink);
  }

  .card-link:hover .vcard__more {
    color: var(--fg);
  }
</style>
