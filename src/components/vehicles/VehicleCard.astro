---
import type { Vehicle } from '@/lib/inventory';
import { coverImage, imageOfKind, statusLabel, vehicleUrl } from '@/lib/inventory';
import { formatMileage, formatPrice } from '@/lib/format';
import Media from '@/components/ui/Media.astro';
import Arrow from '@/components/ui/Arrow.astro';

interface Props {
  vehicle: Vehicle;
  /** CSS aspect-ratio of the image, e.g. '3 / 2', '4 / 5'. */
  ratio?: string;
  /** Which photograph to use. Portrait frames work best with the 'portrait' shot. */
  image?: 'cover' | 'portrait' | 'profile';
  sizes?: string;
  size?: 'large' | 'medium' | 'small';
  /** Shared-element transition into the detail page. Only one per page per vehicle. */
  transition?: boolean;
  headingLevel?: 'h2' | 'h3';
  class?: string;
  delay?: number;
  /** Optional position shown as (01) — for curated, fixed-order selections. */
  index?: number;
}

const {
  vehicle: v,
  ratio = '3 / 2',
  image = 'cover',
  sizes = '(min-width: 64rem) 50vw, 100vw',
  size = 'medium',
  transition = true,
  headingLevel: H = 'h3',
  class: className,
  delay = 0,
  index,
} = Astro.props;

const img = (image !== 'cover' && imageOfKind(v, image)) || coverImage(v);
const url = vehicleUrl(v);
const flagged = v.status !== 'available';
---

<article class:list={['vcard', `vcard--${size}`, className]} data-reveal style={`--delay:${delay}ms`}>
  <a class="card-link" href={url} data-cursor="View">
    <div class="vcard__media media" style={`aspect-ratio:${ratio}`}>
      <Media
        src={img?.src}
        alt={img?.alt ?? ''}
        focal={img?.focal}
        sizes={sizes}
        transitionName={transition ? `vehicle-${v.slug}` : undefined}
      />
      {flagged && <span class="vcard__flag t-meta status-dot" data-status={v.status}>{statusLabel[v.status]}</span>}
    </div>
    <div class="vcard__body">
      <p class="vcard__top">
        <span class="vcard__brand">
          {index != null && <span class="t-index">({String(index).padStart(2, '0')})</span>}
          <span class="t-eyebrow">{v.brand}</span>
        </span>
        <span class="t-meta muted">{v.id}</span>
      </p>
      <div class="vcard__name">
        <H class="vcard__title">{v.model}</H>
        <Arrow class="vcard__arrow" />
      </div>
      {v.variant && <p class="vcard__variant">{v.variant}</p>}
      <dl class="vcard__meta">
        <div><dt class="sr-only">Year</dt><dd class="t-meta">{v.year}</dd></div>
        <div><dt class="sr-only">Mileage</dt><dd class="t-meta">{formatMileage(v.mileage)}</dd></div>
        <div class="vcard__price"><dt class="sr-only">Price</dt><dd>{v.status === 'sold' ? 'Sold' : formatPrice(v.price)}</dd></div>
      </dl>
    </div>
  </a>
</article>

<style>
  .vcard {
    position: relative;
    min-width: 0;
  }

  .card-link {
    display: grid;
    gap: var(--s-5);
  }

  .vcard__media {
    isolation: isolate;
  }

  /* A line of brand colour draws along the base of the image on hover. */
  .vcard__media::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 700ms var(--ease-emphasis);
  }

  .card-link:hover .vcard__media::after {
    transform: scaleX(1);
  }

  .vcard__media :global(img) {
    transition: transform 1400ms var(--ease-emphasis);
  }

  .card-link:hover .vcard__media :global(img) {
    transform: scale(1.04);
  }

  .vcard__flag {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 7px 10px;
    background: color-mix(in srgb, var(--dark-bg) 78%, transparent);
    color: var(--dark-fg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .vcard__body {
    display: grid;
    gap: 6px;
  }

  .vcard__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
  }

  .vcard__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  .vcard__name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: 4px;
  }

  .vcard__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.7rem, 1.35rem + 1.2vw, 2.4rem);
    line-height: 1;
  }

  .vcard--large .vcard__title {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.4rem);
  }

  .vcard--small .vcard__title {
    font-size: clamp(1.45rem, 1.25rem + 0.8vw, 1.9rem);
  }

  .vcard__name :global(.vcard__arrow) {
    width: 22px;
    height: 12px;
    color: var(--muted);
    transition:
      transform 450ms var(--ease-emphasis),
      color var(--dur-micro) var(--ease-standard);
  }

  .card-link:hover .vcard__name :global(.vcard__arrow) {
    color: var(--accent-ink);
  }

  .vcard__variant {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .vcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .vcard__meta dd {
    margin: 0;
  }

  .vcard__meta dd {
    white-space: nowrap;
  }

  .vcard__price {
    margin-left: auto;
    color: var(--fg);
    font-weight: 600;
    font-size: var(--fs-small);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
</style>
