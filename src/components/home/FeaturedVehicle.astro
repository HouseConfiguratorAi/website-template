---
/**
 * The featured car, presented like a model launch: centred name, the
 * photograph edge to edge, four key figures, then price and actions.
 */
import type { Vehicle } from '@/lib/inventory';
import { coverImage, vehicleUrl } from '@/lib/inventory';
import { formatPrice } from '@/lib/format';
import { keyFigures } from '@/lib/specs';
import { home } from '@/config/content';
import Media from '@/components/ui/Media.astro';
import Arrow from '@/components/ui/Arrow.astro';
import Label from '@/components/ui/Label.astro';
import Heading from '@/components/ui/Heading.astro';
import KeyFigures from '@/components/vehicles/KeyFigures.astro';

interface Props { vehicle: Vehicle }
const { vehicle: v } = Astro.props;
const cover = coverImage(v);
---

<section class="featured" data-tone="dark" aria-labelledby="featured-title">
  <div class="container featured__head">
    <Label text={`${home.featured.eyebrow} — ${v.brand}`} align="center" />
    <Heading as="h2" id="featured-title" size="display" text={v.model} class="featured__title" />
    <p class="featured__variant muted" data-reveal="fade">{v.variant} · {v.year}</p>
  </div>

  <a class="featured__frame" href={vehicleUrl(v)} data-cursor="Bekijk" aria-label={`Bekijk de ${v.brand} ${v.model}`} data-scene="through">
    <div class="featured__media media" data-reveal="image">
      <div class="featured__zoom">
        <Media
          src={cover?.src}
          alt={cover?.alt ?? ''}
          sizes="100vw"
          focal="48% 58%"
          transitionName={`vehicle-${v.slug}`}
        />
      </div>
    </div>
  </a>

  <div class="container container--gallery featured__info">
    <KeyFigures figures={keyFigures(v)} />
    <p class="t-lead featured__summary" data-reveal>{v.summary}</p>
    <div class="featured__offer" data-reveal style="--delay:120ms">
      <p class="featured__price">
        <span class="t-meta muted">Vraagprijs</span>
        <span>{formatPrice(v.price)}</span>
      </p>
      <div class="featured__actions">
        <a class="btn btn--primary" href={vehicleUrl(v)}>Ontdek deze auto <Arrow /></a>
        <a class="btn btn--ghost" href={`${vehicleUrl(v)}#aanvraag`}>Plan een bezichtiging</a>
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    padding-top: var(--section-l);
    padding-bottom: var(--section-l);
  }

  .featured__head {
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    text-align: center;
    padding-bottom: var(--s-8);
  }

  .featured__head :global(.featured__title) {
    font-size: clamp(3.2rem, 0.8rem + 10vw, 12rem);
    line-height: 0.86;
  }

  .featured__variant {
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured__frame {
    display: block;
  }

  .featured__media {
    aspect-ratio: 21 / 9;
  }

  .featured__zoom {
    height: 100%;
    transform: scale(calc(1.1 - var(--p, 1) * 0.1));
    transition: transform 1400ms var(--ease-emphasis);
    will-change: transform;
  }

  .featured__frame:hover .featured__zoom {
    transform: scale(calc(1.13 - var(--p, 1) * 0.1));
  }

  .featured__info {
    display: grid;
    justify-items: center;
    gap: var(--s-8);
    padding-top: var(--s-8);
    text-align: center;
  }

  .featured__info :global(.figures) {
    width: 100%;
    max-width: 72rem;
  }

  .featured__summary {
    max-width: 30em;
    color: color-mix(in srgb, var(--fg) 82%, transparent);
  }

  .featured__offer {
    display: grid;
    justify-items: center;
    gap: var(--s-5);
  }

  .featured__price {
    display: grid;
    gap: 10px;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
  }

  @media (max-width: 63.99rem) {
    .featured__media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 47.99rem) {
    .featured__media {
      aspect-ratio: 4 / 3;
    }
    .featured__head {
      padding-bottom: var(--s-6);
    }
    .featured__info {
      gap: var(--s-7);
      padding-top: var(--s-6);
    }
    .featured__summary {
      font-size: var(--fs-body);
    }
    .featured__actions {
      width: 100%;
    }
    .featured__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
