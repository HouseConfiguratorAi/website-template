---
import type { Vehicle } from '@/lib/inventory';
import { coverImage, imageOfKind, vehicleUrl } from '@/lib/inventory';
import { formatMileage, formatPower, formatPrice } from '@/lib/format';
import { home } from '@/config/content';
import Media from '@/components/ui/Media.astro';
import Arrow from '@/components/ui/Arrow.astro';

interface Props { vehicle: Vehicle }
const { vehicle: v } = Astro.props;
const cover = coverImage(v);
const portrait = imageOfKind(v, 'portrait');
const specs = [
  { k: 'Year', v: String(v.year) },
  { k: 'Mileage', v: formatMileage(v.mileage) },
  { k: 'Power', v: formatPower(v.power) },
  { k: 'Price', v: formatPrice(v.price) },
];
---

<section class="featured" data-tone="dark" aria-labelledby="featured-title">
  <div class="container container--gallery">
    <div class="featured__masthead">
      <p class="t-eyebrow eyebrow-row" data-reveal="fade">{home.featured.eyebrow} — {v.brand}</p>
      <p class="t-meta muted featured__issue" data-reveal="fade">{v.id} · {v.location}</p>
    </div>
    <h2 id="featured-title" class="featured__title t-display" data-reveal>
      <span class="sr-only">{v.brand} </span>{v.model}
    </h2>
  </div>

  <a class="featured__frame" href={vehicleUrl(v)} data-cursor="View" aria-label={`View the ${v.brand} ${v.model}`} data-scene="through">
    <div class="featured__media media" data-reveal="image">
      <div class="featured__zoom">
        <Media
          src={cover?.src}
          mobileSrc={portrait?.src}
          alt={cover?.alt ?? ''}
          sizes="(min-width: 100rem) 1600px, 100vw"
          focal="45% 55%"
          transitionName={`vehicle-${v.slug}`}
        />
      </div>
    </div>
  </a>

  <div class="container container--gallery featured__info">
    <p class="t-lead featured__summary" data-reveal>{v.summary}</p>
    <dl class="featured__specs" data-reveal style="--delay:120ms">
      {
        specs.map((s) => (
          <div>
            <dt class="t-eyebrow muted">{s.k}</dt>
            <dd class="t-price">{s.v}</dd>
          </div>
        ))
      }
    </dl>
    <a class="link-arrow featured__cta" href={vehicleUrl(v)} data-reveal style="--delay:200ms">
      View vehicle <Arrow />
    </a>
  </div>
</section>

<style>
  .featured {
    padding-top: var(--section-l);
    padding-bottom: var(--section-l);
  }

  .featured__masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
  }

  /* The model name sits on the image like a magazine masthead. */
  .featured__title {
    position: relative;
    z-index: 2;
    margin-top: var(--s-5);
    margin-bottom: -0.34em;
    font-size: clamp(3.4rem, 0.9rem + 10.6vw, 13rem);
    line-height: 0.88;
    white-space: nowrap;
  }

  .featured__frame {
    display: block;
    width: min(100% - 2 * var(--gutter), var(--w-gallery));
    margin-inline: auto;
  }

  .featured__media {
    aspect-ratio: 16 / 9;
  }

  .featured__zoom {
    height: 100%;
    transform: scale(calc(1.1 - var(--p, 1) * 0.1));
    transition: transform 1400ms var(--ease-emphasis);
    will-change: transform;
  }

  .featured__frame:hover .featured__zoom {
    transform: scale(calc(1.13 - var(--p, 1) * 0.1));
  }

  .featured__info {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-6);
    padding-top: var(--s-7);
    align-items: start;
  }

  .featured__summary {
    grid-column: 1 / span 5;
  }

  .featured__specs {
    grid-column: 7 / -1;
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: var(--s-5);
  }

  .featured__specs div {
    display: grid;
    gap: 10px;
  }

  .featured__specs dd {
    margin: 0;
  }

  .featured__cta {
    grid-column: 7 / -1;
    justify-self: start;
  }

  @media (max-width: 63.99rem) {
    .featured__summary,
    .featured__specs,
    .featured__cta {
      grid-column: 1 / -1;
    }
    .featured__specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
      padding-top: var(--s-5);
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 47.99rem) {
    .featured__media {
      aspect-ratio: 4 / 5;
    }
    .featured__frame {
      width: 100%;
    }
    .featured__issue {
      display: none;
    }
  }
</style>
