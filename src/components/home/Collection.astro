---
/**
 * The range: an orderly grid of equal cards under a centred heading,
 * closed by one clear action.
 */
import type { Vehicle } from '@/lib/inventory';
import { home } from '@/config/content';
import SectionHead from '@/components/ui/SectionHead.astro';
import VehicleCard from '@/components/vehicles/VehicleCard.astro';
import Arrow from '@/components/ui/Arrow.astro';

interface Props { vehicles: Vehicle[]; total?: number }
const { vehicles, total } = Astro.props;
const c = home.collection;
---

<section class="collection" data-tone="light">
  <div class="container container--gallery">
    <SectionHead eyebrow={c.eyebrow} headline={c.headline} body={c.body} />
    <ul class="collection__grid" role="list" data-swipe>
      {
        vehicles.map((v, i) => (
          <li>
            <VehicleCard vehicle={v} ratio="3 / 2" sizes="(min-width: 64rem) 48vw, 100vw" delay={(i % 2) * 120} />
          </li>
        ))
      }
    </ul>
    <div class="collection__progress" aria-hidden="true"><span data-swipe-bar></span></div>
    <div class="collection__foot" data-reveal>
      <a class="btn btn--primary" href={c.cta.href}>{c.cta.label}{total ? ` (${total})` : ''}<Arrow /></a>
    </div>
  </div>
</section>

<style>
  .collection {
    padding-block: var(--section-l);
  }

  .collection__grid {
    list-style: none;
    padding: 0;
    margin: var(--section-s) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-9) var(--gutter);
  }

  .collection__foot {
    display: flex;
    justify-content: center;
    margin-top: var(--section-s);
  }

  .collection__progress {
    display: none;
  }

  /* Phones: a swipeable row instead of four tall cards — the next car peeks in. */
  @media (max-width: 47.99rem) {
    .collection__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      gap: var(--s-4);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .collection__grid::-webkit-scrollbar {
      display: none;
    }
    .collection__grid > li {
      scroll-snap-align: start;
    }
    .collection__progress {
      display: block;
      position: relative;
      height: 2px;
      margin-top: var(--s-6);
      background: var(--border);
      overflow: hidden;
    }
    .collection__progress span {
      position: absolute;
      inset: 0 auto 0 0;
      width: var(--w, 25%);
      background: var(--accent);
      transform: translateX(calc(var(--x, 0) * (100% / var(--w-n, 0.25) - 100%)));
    }
    .collection__foot {
      margin-top: var(--s-7);
    }
    .collection__foot .btn {
      width: 100%;
    }
  }
</style>

<script>
  // Progress line under the phone carousel.
  document.querySelectorAll<HTMLElement>('[data-swipe]').forEach((track) => {
    const bar = track.parentElement?.querySelector<HTMLElement>('[data-swipe-bar]');
    if (!bar) return;
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      const share = Math.min(1, track.clientWidth / track.scrollWidth);
      bar.style.setProperty('--w', `${share * 100}%`);
      bar.style.setProperty('--w-n', String(share));
      bar.style.setProperty('--x', max > 0 ? (track.scrollLeft / max).toFixed(4) : '0');
    };
    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();
  });
</script>
