---
import { home } from '@/config/content';
import { getVehicle, vehicleUrl } from '@/lib/inventory';
import Media from '@/components/ui/Media.astro';
import Arrow from '@/components/ui/Arrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LiveStatus from '@/components/ui/LiveStatus.astro';

const h = home.hero;
const captionVehicle = h.captionVehicle ? await getVehicle(h.captionVehicle) : undefined;
---

<section class="hero" data-tone="dark" data-scene="through" aria-labelledby="hero-title">
  <div class="hero__media">
    <div class="hero__drift">
      <div class="hero__settle" data-intro="settle">
        <Media
          src={h.image}
          mobileSrc={h.imageMobile}
          alt={h.imageAlt}
          priority
          sizes="100vw"
          focal="62% 60%"
          mobileFocal="50% 80%"
        />
      </div>
    </div>
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__label t-eyebrow" data-intro="fade" style="--intro:150ms">{h.eyebrow}</p>
    <Heading as="h1" id="hero-title" size="display" text={h.headline} reveal="load" delay={250} class="hero__title" />
    <p class="hero__support" data-intro style="--intro:450ms">{h.supporting}</p>
    <div class="hero__actions" data-intro style="--intro:600ms">
      <a class="btn btn--primary" href={h.primary.href}>{h.primary.label}<Arrow /></a>
      <a class="btn btn--ghost" href={h.secondary.href}>{h.secondary.label}</a>
    </div>
  </div>

  <div class="hero__foot t-meta" data-intro="fade" style="--intro:900ms">
    {
      captionVehicle ? (
        <a class="hero__caption" href={vehicleUrl(captionVehicle)}>
          <span class="muted">In de hal</span>
          <span class="link">{captionVehicle.brand} {captionVehicle.model} — {captionVehicle.variant}</span>
        </a>
      ) : (
        <span />
      )
    }
    <span class="hero__scroll" aria-hidden="true"><i></i></span>
    <LiveStatus class="hero__hours" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: clip;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__drift,
  .hero__settle {
    height: 100%;
  }

  /* Camera drift: the photograph moves slower than the page. */
  .hero__drift {
    transform: translate3d(0, calc(var(--p, 0) * 16%), 0);
    will-change: transform;
  }

  /* Darkest at the foot, where the words sit, and a little at the top for the header. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.86) 0%, rgb(0 0 0 / 0.45) 32%, transparent 62%),
      radial-gradient(120% 70% at 50% 100%, rgb(0 0 0 / 0.35), transparent 70%);
  }

  /* Centred, like a model launch: label, name, one line, two actions. */
  .hero__content {
    align-self: end;
    width: min(100% - 2 * var(--gutter), 64rem);
    margin-inline: auto;
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: var(--s-8);
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    text-align: center;
  }

  .hero__content :global(.hero__title) {
    font-size: clamp(2.8rem, 0.8rem + 7vw, 8rem);
    line-height: 0.92;
  }

  .hero__support {
    max-width: 34rem;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: color-mix(in srgb, var(--fg) 82%, transparent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .hero__foot {
    width: min(100% - 2 * var(--gutter), var(--w-gallery));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-5);
    border-top: 1px solid var(--border);
  }

  .hero__caption {
    justify-self: start;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .hero__foot :global(.hero__hours) {
    justify-self: end;
  }

  /* Scroll cue: a red line travelling down a hairline, centred under the actions. */
  .hero__scroll {
    position: relative;
    width: 1px;
    height: 36px;
    background: var(--border);
    overflow: hidden;
  }

  :global(.motion) .hero__scroll::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-ink);
    animation: scroll-cue 2.4s var(--ease-smooth) 1.6s infinite;
  }

  @keyframes scroll-cue {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @media (max-width: 63.99rem) {
    .hero__foot :global(.hero__hours) {
      display: none;
    }
    .hero__foot {
      grid-template-columns: 1fr auto;
    }
    .hero__scroll {
      display: none;
    }
  }

  /* Phones: the tall crop puts the car low, so words sit at the top
     and the car anchors the bottom of the screen. */
  @media (max-width: 47.99rem) {
    .hero__content {
      align-self: start;
      padding-top: calc(var(--header-h) + var(--s-7));
      gap: var(--s-4);
    }
    .hero__veil {
      background:
        linear-gradient(to bottom, rgb(0 0 0 / 0.82) 0%, rgb(0 0 0 / 0.4) 50%, transparent 66%),
        linear-gradient(to top, rgb(0 0 0 / 0.6) 0%, transparent 24%);
    }
    .hero__actions {
      width: 100%;
    }
    .hero__actions .btn {
      flex: 1 1 auto;
    }
    .hero__actions .btn--ghost {
      display: none;
    }
    .hero__foot {
      grid-template-columns: 1fr;
    }
    .hero__caption .muted {
      display: none;
    }
  }
</style>
