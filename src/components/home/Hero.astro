---
import { home } from '@/config/content';
import { getVehicle, vehicleUrl } from '@/lib/inventory';
import Media from '@/components/ui/Media.astro';
import Arrow from '@/components/ui/Arrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LiveStatus from '@/components/ui/LiveStatus.astro';

const h = home.hero;
const captionVehicle = h.captionVehicle ? await getVehicle(h.captionVehicle) : undefined;
---

<section class="hero" data-tone="dark" data-scene="through" aria-labelledby="hero-title">
  <div class="hero__media">
    <div class="hero__drift">
      <div class="hero__settle" data-intro="settle">
        <Media
          src={h.image}
          mobileSrc={h.imageMobile}
          alt={h.imageAlt}
          priority
          sizes="100vw"
          focal="70% 60%"
          mobileFocal="50% 80%"
        />
      </div>
    </div>
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__label" data-intro="fade" style="--intro:150ms">
      <span class="t-index">(01)</span>
      <span class="t-eyebrow">{h.eyebrow}</span>
    </p>
    <Heading as="h1" id="hero-title" size="display" text={h.headline} reveal="load" delay={250} class="hero__title" />
    <div class="hero__row">
      <p class="hero__support" data-intro style="--intro:450ms">{h.supporting}</p>
      <div class="hero__actions" data-intro style="--intro:600ms">
        <a class="btn btn--primary" href={h.primary.href}>{h.primary.label}<Arrow /></a>
        <a class="btn btn--ghost" href={h.secondary.href}>{h.secondary.label}</a>
      </div>
    </div>
  </div>

  <div class="hero__foot t-meta" data-intro="fade" style="--intro:900ms">
    {
      captionVehicle ? (
        <a class="hero__caption link" href={vehicleUrl(captionVehicle)}>
          <span class="muted">In the hall</span>
          <span>{captionVehicle.brand} {captionVehicle.model} — {captionVehicle.variant}</span>
        </a>
      ) : (
        <span />
      )
    }
    <LiveStatus class="hero__hours" />
    <span class="hero__scroll muted" aria-hidden="true">Scroll <i></i></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: clip;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__drift,
  .hero__settle {
    height: 100%;
  }

  /* Camera drift: the photograph moves slower than the page. */
  .hero__drift {
    transform: translate3d(0, calc(var(--p, 0) * 16%), 0);
    will-change: transform;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, rgb(0 0 0 / 0.72) 0%, rgb(0 0 0 / 0.28) 45%, transparent 65%),
      linear-gradient(to top, rgb(0 0 0 / 0.75) 0%, transparent 42%);
  }

  .hero__content {
    align-self: end;
    width: min(100% - 2 * var(--gutter), var(--w-gallery));
    margin-inline: auto;
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: var(--s-8);
    display: grid;
    gap: var(--s-6);
  }

  .hero__label {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .hero__content :global(.hero__title) {
    max-width: 6.4em;
    font-size: clamp(3.5rem, 1rem + 9.6vw, 10rem);
  }

  .hero__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-6);
    align-items: end;
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
    max-width: 62rem;
  }

  .hero__support {
    grid-column: 1 / span 6;
    max-width: 30rem;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
  }

  .hero__actions {
    grid-column: 7 / -1;
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .hero__foot {
    width: min(100% - 2 * var(--gutter), var(--w-gallery));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-5);
    border-top: 1px solid var(--border);
  }

  .hero__caption {
    justify-self: start;
    display: inline-flex;
    gap: 12px;
  }

  .hero__scroll {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 28px;
    background: var(--border);
    overflow: hidden;
  }

  :global(.motion) .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-ink);
    animation: scroll-cue 2.4s var(--ease-smooth) 1.6s infinite;
  }

  @keyframes scroll-cue {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @media (max-width: 63.99rem) {
    .hero__support {
      grid-column: 1 / -1;
    }
    .hero__actions {
      grid-column: 1 / -1;
      justify-self: start;
    }
    .hero__foot :global(.hero__hours) {
      display: none;
    }
    .hero__foot {
      grid-template-columns: 1fr auto;
    }
  }

  /* Phones: the tall crop puts the car low, so words sit at the top
     and the car anchors the bottom of the screen. */
  @media (max-width: 47.99rem) {
    .hero__content {
      align-self: start;
      padding-top: calc(var(--header-h) + var(--s-7));
      gap: var(--s-5);
    }
    .hero__veil {
      background:
        linear-gradient(to bottom, rgb(0 0 0 / 0.82) 0%, rgb(0 0 0 / 0.4) 48%, transparent 64%),
        linear-gradient(to top, rgb(0 0 0 / 0.6) 0%, transparent 24%);
    }
    .hero__row {
      border-top: 0;
      padding-top: 0;
    }
    .hero__actions .btn {
      flex: 1 1 auto;
    }
    .hero__actions .btn--ghost {
      display: none;
    }
    .hero__scroll {
      display: none;
    }
    .hero__foot {
      grid-template-columns: 1fr;
    }
    .hero__caption .muted {
      display: none;
    }
  }
</style>
