---
import { home } from '@/config/content';
import { plain, splitWords } from '@/lib/text';
import Label from '@/components/ui/Label.astro';

const s = home.statement;
---

<section class="statement" data-tone="light">
  <div class="container statement__inner">
    <Label text={s.eyebrow} align="center" />
    <h2 class="t-display statement__text" data-split>
      <span class="sr-only">{plain(s.lines.join(' '))}</span>
      <span aria-hidden="true">
        {s.lines.map((line) => <span class="statement__line" set:html={splitWords(line)} />)}
      </span>
    </h2>
    <p class="t-lead statement__body" data-reveal style="--delay:300ms">{s.body}</p>
  </div>
</section>

<style>
  .statement {
    padding-block: var(--section-l);
  }

  .statement__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-7);
    text-align: center;
  }

  .statement__text {
    max-width: 20ch;
    font-size: clamp(1.9rem, 0.9rem + 3.6vw, 4.5rem);
    line-height: 1;
  }

  .statement__line {
    display: block;
  }

  .statement__body {
    max-width: 30em;
    color: var(--muted);
  }
</style>
