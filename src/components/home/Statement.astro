---
import { home } from '@/config/content';
import { plain } from '@/lib/text';

const s = home.statement;
// Split into words server-side so each can be revealed in sequence.
let i = 0;
const lines = s.lines.map((line) =>
  line.split(' ').map((word) => {
    const em = /^\*.*\*[.,]?$/.test(word) || /^\*/.test(word);
    return { text: word.replace(/\*/g, ''), em, i: i++ };
  }),
);
---

<section class="statement" data-tone="light">
  <div class="container container--gallery statement__grid">
    <p class="t-eyebrow eyebrow-row statement__eyebrow" data-reveal="fade">{s.eyebrow}</p>
    <h2 class="t-display statement__text" data-words>
      <span class="sr-only">{plain(s.lines.join(' '))}</span>
      <span aria-hidden="true">
      {
        lines.map((words) => (
          <span class="statement__line">
            {words.map((w) => (
              <>
                <span class="w" style={`--i:${w.i}`}>{w.em ? <em>{w.text}</em> : w.text}</span>{' '}
              </>
            ))}
          </span>
        ))
      }
      </span>
    </h2>
    <p class="t-lead statement__body" data-reveal style="--delay:300ms">{s.body}</p>
  </div>
</section>

<style>
  .statement {
    padding-block: var(--section-xl);
  }

  .statement__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-8);
  }

  .statement__eyebrow {
    grid-column: 1 / -1;
  }

  .statement__text {
    grid-column: 1 / -1;
    font-size: clamp(2.75rem, 1.2rem + 6.6vw, 8.75rem);
    line-height: 0.98;
  }

  .statement__line {
    display: block;
  }

  /* The second line steps in — an editorial indent rather than a centred block. */
  .statement__line:nth-child(2) {
    padding-left: 1.6em;
  }

  .statement__body {
    grid-column: 7 / span 5;
    max-width: 26em;
  }

  @media (max-width: 63.99rem) {
    .statement__body {
      grid-column: 3 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .statement__line:nth-child(2) {
      padding-left: 0.6em;
    }
    .statement__body {
      grid-column: 1 / -1;
    }
  }
</style>
