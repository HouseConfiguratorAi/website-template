---
/**
 * Quick actions for phones: stock, call, contact — always one thumb away.
 * It slides in once the visitor has scrolled past the opening screen and
 * steps aside while the on-screen keyboard or a sticky offer bar needs the space.
 */
import { contact } from '@/config/site';
import { getListedVehicles } from '@/lib/inventory';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const count = (await getListedVehicles()).length;
const items = [
  { href: '/voorraad', label: 'Voorraad', badge: String(count), icon: 'grid', current: path.startsWith('/voorraad') },
  { href: `tel:${contact.phoneHref}`, label: 'Bellen', icon: 'phone', current: false },
  { href: '/contact', label: 'Contact', icon: 'mail', current: path === '/contact' },
];
---

<nav class="dock" data-tone="dark" aria-label="Snelle acties" data-dock>
  <ul role="list">
    {
      items.map((it) => (
        <li>
          <a href={it.href} aria-current={it.current ? 'page' : undefined}>
            <span class="dock__icon" aria-hidden="true">
              {it.icon === 'grid' && (
                <svg viewBox="0 0 20 20"><rect x="2" y="2" width="7" height="7" /><rect x="11" y="2" width="7" height="7" /><rect x="2" y="11" width="7" height="7" /><rect x="11" y="11" width="7" height="7" /></svg>
              )}
              {it.icon === 'phone' && (
                <svg viewBox="0 0 20 20"><path d="M6.5 2.5l2 4-1.8 1.4a9 9 0 004.4 4.4l1.4-1.8 4 2-.6 3a1.6 1.6 0 01-1.7 1.3A14 14 0 012.2 4.8 1.6 1.6 0 013.5 3.1z" stroke-linejoin="round" /></svg>
              )}
              {it.icon === 'mail' && (
                <svg viewBox="0 0 20 20"><rect x="2" y="4" width="16" height="12" /><path d="M2.5 4.5L10 11l7.5-6.5" /></svg>
              )}
              {it.badge && <span class="dock__badge">{it.badge}</span>}
            </span>
            <span class="dock__label">{it.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .dock {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .dock {
      display: block;
      position: fixed;
      inset: auto 0 0;
      z-index: 40;
      padding-bottom: env(safe-area-inset-bottom);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      -webkit-backdrop-filter: blur(18px) saturate(1.2);
      backdrop-filter: blur(18px) saturate(1.2);
      border-top: 1px solid var(--border);
      transition: transform 500ms var(--ease-emphasis);
    }

    .dock[data-hidden] {
      transform: translateY(105%);
    }

    /* Room at the end of every page so the dock never covers the footer. */
    :global(body:has(.dock)) {
      padding-bottom: calc(60px + env(safe-area-inset-bottom));
    }
  }

  .dock ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .dock li + li {
    border-left: 1px solid var(--border);
  }

  .dock a {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 5px;
    min-height: 60px;
    color: color-mix(in srgb, var(--fg) 78%, transparent);
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-micro), background-color var(--dur-micro);
  }

  .dock a:active {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }

  .dock a[aria-current='page'] {
    color: var(--fg);
  }

  .dock__icon {
    position: relative;
  }

  .dock svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .dock__badge {
    position: absolute;
    top: -6px;
    right: -12px;
    min-width: 16px;
    height: 16px;
    padding-inline: 4px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
  }

  .dock__label {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .dock a[aria-current='page'] .dock__label {
    box-shadow: 0 2px 0 var(--accent);
  }
</style>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    // Hidden on the opening screen; shown once the visitor starts exploring.
    const sync = () => {
      const typing = document.activeElement?.matches('input:not([type="radio"]):not([type="checkbox"]), textarea, select');
      dock.toggleAttribute('data-hidden', window.scrollY < 320 || !!typing);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    document.addEventListener('focusin', sync);
    document.addEventListener('focusout', () => setTimeout(sync, 50));
  }
</script>
