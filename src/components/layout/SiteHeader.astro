---
import { navigation, contact, site } from '@/config/site';
import Logo from '@/components/ui/Logo.astro';
import Arrow from '@/components/ui/Arrow.astro';
import { pad } from '@/lib/format';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" data-tone="dark" data-state="top">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label={`${site.name} — home`}>
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul role="list">
        {
          navigation.primary.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__cta btn btn--primary" href={navigation.cta.href}>
        {navigation.cta.label}
        <Arrow />
      </a>
      <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
        <span>Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <span class="site-header__progress" aria-hidden="true"></span>
</header>

<dialog class="menu" id="site-menu" data-tone="dark" aria-label="Menu">
  <div class="menu__top">
    <a href="/" class="menu__logo" aria-label={`${site.name} — home`}><Logo /></a>
    <button class="menu-toggle is-close" type="button" data-menu-close>
      <span>Close</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
  <nav class="menu__nav" aria-label="Main">
    <ol role="list">
      {
        [{ label: 'Home', href: '/' }, ...navigation.primary].map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="t-index">{pad(i + 1)}</span>
              <span class="menu__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot">
    <a class="btn btn--primary btn--block" href={navigation.cta.href}>
      {navigation.cta.label}
      <Arrow />
    </a>
    <dl class="menu__contact">
      <div><dt class="t-meta muted">Email</dt><dd><a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      <div><dt class="t-meta muted">Phone</dt><dd><a class="link" href={`tel:${contact.phoneHref}`}>{contact.phone}</a></dd></div>
      <div><dt class="t-meta muted">Visit</dt><dd>{contact.address.street}, {contact.address.city}</dd></div>
    </dl>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    background: transparent;
    color: var(--fg);
    border-bottom: 1px solid transparent;
    transition:
      background-color 500ms var(--ease-standard),
      border-color 500ms var(--ease-standard),
      transform 600ms var(--ease-emphasis);
  }

  /* Legibility veil while the header floats over imagery. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -40px;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0));
    pointer-events: none;
    transition: opacity 500ms var(--ease-standard);
  }

  .site-header[data-state='scrolled'] {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    border-bottom-color: var(--border);
  }

  .site-header[data-state='scrolled']::before {
    opacity: 0;
  }

  /* Out of the way while reading down; back as soon as the visitor scrolls up. */
  .site-header[data-hidden] {
    transform: translate3d(0, -100%, 0);
  }

  /* Reading progress: a hairline of brand colour along the bottom edge. */
  .site-header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent-ink);
    transform: scaleX(var(--progress, 0));
    transform-origin: 0 50%;
    opacity: 0;
    transition: opacity 400ms var(--ease-standard);
  }

  .site-header[data-state='scrolled'] .site-header__progress {
    opacity: 1;
  }

  .site-header__inner {
    position: relative;
    height: 100%;
    width: min(100% - 2 * var(--gutter), var(--w-gallery));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-6);
  }

  .site-header__logo {
    justify-self: start;
    min-width: 0;
    max-width: 100%;
    display: inline-flex;
    padding-block: 10px;
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(22px, 2.6vw, 44px);
  }

  .site-header__nav a {
    position: relative;
    display: inline-block;
    padding-block: 8px;
    font-size: var(--fs-nav);
    font-weight: 500;
    letter-spacing: 0.005em;
    color: color-mix(in srgb, var(--fg) 78%, transparent);
    transition: color var(--dur-micro) var(--ease-standard);
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent-ink);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 500ms var(--ease-emphasis);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--fg);
  }

  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .site-header__cta {
    min-height: 42px;
    padding-inline: 18px;
    font-size: 0.75rem;
  }

  :global(.motion) .site-header__inner {
    animation: fade-in 800ms var(--ease-standard) 700ms both;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-inline: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .menu-toggle__icon {
    display: grid;
    gap: 6px;
    width: 22px;
  }

  .menu-toggle__icon i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-standard) var(--ease-emphasis);
  }

  .menu-toggle__icon i:last-child {
    width: 14px;
    justify-self: end;
    background: var(--accent-ink);
  }

  .menu-toggle.is-close .menu-toggle__icon i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-toggle.is-close .menu-toggle__icon i:last-child {
    width: 22px;
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 63.99rem) {
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .site-header__nav,
    .site-header__cta {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  /* ---- Full-screen menu ---- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) max(var(--s-6), env(safe-area-inset-bottom));
    border: 0;
    display: none;
    flex-direction: column;
    overflow-y: auto;
    opacity: 0;
    transition:
      opacity 400ms var(--ease-standard),
      display 400ms allow-discrete,
      overlay 400ms allow-discrete;
  }

  .menu[open] {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__top {
    height: var(--header-h);
    flex: none;
    gap: var(--s-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
  }

  .menu__logo {
    min-width: 0;
    display: flex;
  }

  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: var(--s-7);
  }

  .menu__nav ol {
    width: 100%;
    display: grid;
  }

  .menu__nav li {
    border-bottom: 1px solid var(--border);
  }

  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    padding-block: 10px;
  }

  .menu__label {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2.4rem, 1.4rem + 5vw, 4.5rem);
    line-height: 1;
    transition: color var(--dur-micro) var(--ease-standard), transform 500ms var(--ease-emphasis);
  }

  .menu__nav a:hover .menu__label,
  .menu__nav a[aria-current='page'] .menu__label {
    color: var(--accent-ink);
  }

  .menu__nav a:hover .menu__label {
    transform: translateX(8px);
  }

  .menu__nav li {
    transition:
      opacity 500ms var(--ease-standard),
      transform 800ms var(--ease-emphasis);
    transition-delay: calc(120ms + var(--i) * 50ms);
  }

  @starting-style {
    .menu[open] .menu__nav li {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .menu__foot {
    display: grid;
    gap: var(--s-6);
  }

  .menu__contact {
    display: grid;
    gap: 10px;
    font-size: var(--fs-small);
  }

  .menu__contact div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    align-items: baseline;
  }

  .menu__contact dd {
    margin: 0;
  }

  :global(html:has(.menu[open])) {
    overflow: hidden;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (header) {
    let ticking = false;
    let lastY = window.scrollY;
    const update = () => {
      const y = window.scrollY;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      header.dataset.state = y > 24 ? 'scrolled' : 'top';
      header.style.setProperty('--progress', max > 0 ? (y / max).toFixed(4) : '0');
      // Hide when reading down past the opening scene; show on any upward scroll.
      const down = y > lastY + 4;
      const up = y < lastY - 4;
      const keep = header.contains(document.activeElement);
      if (down && y > 480 && !keep) header.setAttribute('data-hidden', '');
      else if (up || y <= 480) header.removeAttribute('data-hidden');
      document.documentElement.toggleAttribute('data-header-hidden', header.hasAttribute('data-hidden'));
      if (down || up) lastY = y;
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    header.addEventListener('focusin', () => {
      header.removeAttribute('data-hidden');
      document.documentElement.removeAttribute('data-header-hidden');
    });
  }

  if (menu && openBtn) {
    openBtn.addEventListener('click', () => {
      menu.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && menu.open && menu.close());
  }
</script>
