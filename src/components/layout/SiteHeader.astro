---
import { navigation, contact, site } from '@/config/site';
import Logo from '@/components/ui/Logo.astro';
import Arrow from '@/components/ui/Arrow.astro';
import { pad } from '@/lib/format';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" data-tone="dark" data-state="top">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label={`${site.name} — home`}>
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul role="list">
        {
          navigation.primary.map((item) => (
            <li>
              <a class="link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__cta link-arrow" href={navigation.cta.href}>
        {navigation.cta.label}
        <Arrow />
      </a>
      <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
        <span>Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" data-tone="dark" aria-label="Menu">
  <div class="menu__top">
    <a href="/" class="menu__logo" aria-label={`${site.name} — home`}><Logo /></a>
    <button class="menu-toggle is-close" type="button" data-menu-close>
      <span>Close</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
  <nav class="menu__nav" aria-label="Main">
    <ol role="list">
      {
        [{ label: 'Home', href: '/' }, ...navigation.primary].map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="t-index">{pad(i + 1)}</span>
              <span class="menu__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot">
    <a class="btn btn--primary btn--block" href={navigation.cta.href}>
      {navigation.cta.label}
      <Arrow />
    </a>
    <div class="menu__contact t-small">
      <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="link" href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
      <span class="muted">{contact.address.street}, {contact.address.city}</span>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    background: transparent;
    color: var(--fg);
    transition:
      background-color 500ms var(--ease-standard),
      border-color 500ms var(--ease-standard),
      backdrop-filter 500ms var(--ease-standard);
    border-bottom: 1px solid transparent;
  }

  /* Legibility veil while the header floats over imagery. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -40px;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.42), rgb(0 0 0 / 0));
    pointer-events: none;
    transition: opacity 500ms var(--ease-standard);
  }

  .site-header[data-state='scrolled'] {
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    border-bottom-color: var(--border);
  }

  .site-header[data-state='scrolled']::before {
    opacity: 0;
  }

  .site-header__inner {
    position: relative;
    height: 100%;
    width: min(100% - 2 * var(--gutter), var(--w-gallery));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-6);
  }

  .site-header__logo {
    justify-self: start;
    min-width: 0;
    max-width: 100%;
    display: inline-flex;
    padding-block: 10px;
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(20px, 2.4vw, 40px);
  }

  .site-header__nav a {
    font-size: var(--fs-nav);
    letter-spacing: 0.02em;
    padding-block: 6px;
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .site-header__cta {
    padding-block: 6px;
  }

  .motion .site-header__inner {
    animation: fade-in 800ms var(--ease-standard) 700ms both;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-inline: 4px;
    font-size: var(--fs-caption);
    font-stretch: 116%;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .menu-toggle__icon {
    display: grid;
    gap: 6px;
    width: 22px;
  }

  .menu-toggle__icon i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-standard) var(--ease-emphasis);
  }

  .menu-toggle.is-close .menu-toggle__icon i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-toggle.is-close .menu-toggle__icon i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 63.99rem) {
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .site-header__nav,
    .site-header__cta {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  /* ---- Full-screen menu ---- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) max(var(--s-6), env(safe-area-inset-bottom));
    border: 0;
    display: none;
    flex-direction: column;
    overflow-y: auto;
    opacity: 0;
    transition:
      opacity 400ms var(--ease-standard),
      display 400ms allow-discrete,
      overlay 400ms allow-discrete;
  }

  .menu[open] {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__top {
    height: var(--header-h);
    flex: none;
    gap: var(--s-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu__logo {
    min-width: 0;
    display: flex;
  }

  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: var(--s-7);
  }

  .menu__nav ol {
    width: 100%;
    display: grid;
    gap: 2px;
  }

  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    padding-block: 6px;
  }

  .menu__label {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2.5rem, 1.5rem + 5vw, 4.5rem);
    line-height: 1.02;
  }

  .menu__nav a[aria-current='page'] .menu__label {
    font-style: var(--display-italic);
    color: var(--accent);
  }

  .menu__nav li {
    transition:
      opacity 500ms var(--ease-standard),
      transform 800ms var(--ease-emphasis);
    transition-delay: calc(120ms + var(--i) * 50ms);
  }

  @starting-style {
    .menu[open] .menu__nav li {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .menu__foot {
    display: grid;
    gap: var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--border);
  }

  .menu__contact {
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  :global(html:has(.menu[open])) {
    overflow: hidden;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  // Header: transparent over the opening scene, translucent once the page moves.
  if (header) {
    let ticking = false;
    const update = () => {
      header.dataset.state = window.scrollY > 24 ? 'scrolled' : 'top';
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  if (menu && openBtn) {
    openBtn.addEventListener('click', () => {
      menu.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    // Close when navigating within the page, and if the viewport grows past the breakpoint.
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && menu.open && menu.close());
  }
</script>
