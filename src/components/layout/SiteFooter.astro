---
import { navigation, contact, site } from '@/config/site';
import { getListedVehicles, vehicleUrl } from '@/lib/inventory';
import Logo from '@/components/ui/Logo.astro';
import LiveStatus from '@/components/ui/LiveStatus.astro';
import Arrow from '@/components/ui/Arrow.astro';

const year = new Date().getFullYear();
// One link per model currently on the floor.
const models = [...new Map((await getListedVehicles()).map((v) => [`${v.brand} ${v.model}`, v])).values()].slice(0, 5);
---

<footer class="site-footer" data-tone="dark">
  <div class="container container--gallery">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label={`${site.name} — home`}><Logo size="large" /></a>
      <p class="site-footer__line muted">Geselecteerde sport- en GT-auto’s · {contact.address.city}</p>
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-label="Aanbod">
        <h2 class="t-eyebrow">Aanbod</h2>
        <ul role="list">
          {models.map((v) => <li><a class="link" href={vehicleUrl(v)}>{v.brand} {v.model}</a></li>)}
          <li><a class="link site-footer__all" href="/aanbod">Volledig aanbod</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Footer">
        <h2 class="t-eyebrow">Oberhall</h2>
        <ul role="list">
          {navigation.primary.filter((i) => i.href !== '/aanbod').map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="t-eyebrow">Showroom</h2>
        <address>
          {contact.address.street}<br />
          {contact.address.postalCode} {contact.address.city}<br />
          {contact.address.country}
        </address>
        <ul role="list" class="site-footer__hours">
          {contact.hours.map((h) => <li><span>{h.days}</span><span class="muted">{h.time}</span></li>)}
        </ul>
        <a class="link" href={contact.directionsUrl} rel="noopener" target="_blank">Routebeschrijving<span class="sr-only"> (opent in een nieuw tabblad)</span></a>
      </div>

      <div class="site-footer__col">
        <h2 class="t-eyebrow">Contact</h2>
        <ul role="list">
          <li><a class="link" href={`tel:${contact.phoneHref}`}>{contact.phone}</a></li>
          <li><a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
        </ul>
        <LiveStatus city={false} />
        <ul role="list" class="site-footer__social">
          {site.social.map((s) => <li><a class="link" href={s.href} rel="noopener" target="_blank">{s.label}<span class="sr-only"> (opent in een nieuw tabblad)</span></a></li>)}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom t-meta">
      <p class="site-footer__legal">
        <span>© {year} {site.legalName}</span>
        <span>KvK {contact.registration.kvk}</span>
        <span>Btw {contact.registration.vat}</span>
      </p>
      <ul role="list">
        {navigation.legal.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        <li><a class="site-footer__top-link" href="#main">Naar boven <Arrow direction="up" /></a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--section-m);
    padding-bottom: var(--s-6);
    border-top: 1px solid var(--border);
  }

  /* The mark, centred, with a short red rule — the signature of the page. */
  .site-footer__brand {
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    padding-bottom: var(--section-s);
    text-align: center;
  }

  .site-footer__brand::after {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--accent);
    order: -1;
  }

  .site-footer__logo {
    display: inline-flex;
    max-width: 100%;
  }

  .site-footer__line {
    font-size: var(--fs-small);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-7) var(--gutter);
    padding-block: var(--s-8);
    border-top: 1px solid var(--border);
  }

  .site-footer__col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--s-4);
    font-size: var(--fs-small);
    font-style: normal;
  }

  .site-footer__col h2 {
    margin-bottom: var(--s-2);
  }

  .site-footer__col ul {
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  .site-footer__all {
    color: var(--accent-ink);
  }

  address {
    font-style: normal;
    line-height: 1.6;
  }

  .site-footer__hours {
    width: 100%;
    max-width: 17rem;
    justify-items: stretch !important;
    gap: 4px !important;
  }

  .site-footer__hours li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--s-4);
  }

  .site-footer__social {
    margin-top: var(--s-2);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--s-5);
  }

  .site-footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
  }

  .site-footer__bottom a {
    color: var(--fg);
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .site-footer__top-link :global(.arrow) {
    color: var(--accent-ink);
    transition: translate 450ms var(--ease-emphasis);
  }

  .site-footer__top-link:hover :global(.arrow) {
    transform: none;
    translate: 0 -3px;
  }

  @media (max-width: 63.99rem) {
    .site-footer__cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 29.99rem) {
    .site-footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
