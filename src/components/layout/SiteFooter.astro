---
import { navigation, contact, site } from '@/config/site';
import LiveStatus from '@/components/ui/LiveStatus.astro';
import Arrow from '@/components/ui/Arrow.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer" data-tone="dark">
  <div class="container container--gallery">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="t-lead site-footer__line">Selected sports and grand touring cars, {contact.address.city}.</p>
      </div>

      <nav class="site-footer__col" aria-label="Footer">
        <h2 class="t-meta muted">Navigate</h2>
        <ul role="list">
          {navigation.primary.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="t-meta muted">Visit</h2>
        <address>
          {contact.address.street}<br />
          {contact.address.postalCode} {contact.address.city}<br />
          {contact.address.country}
        </address>
        <a class="link" href={contact.directionsUrl} rel="noopener" target="_blank">Directions<span class="sr-only"> (opens in a new tab)</span></a>
      </div>

      <div class="site-footer__col">
        <h2 class="t-meta muted">Contact</h2>
        <ul role="list">
          <li><a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a class="link" href={`tel:${contact.phoneHref}`}>{contact.phone}</a></li>
          {site.social.map((s) => <li><a class="link" href={s.href} rel="noopener" target="_blank">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
        </ul>
      </div>
    </div>

    {site.logo.type !== 'image' && <p class="site-footer__mark" aria-hidden="true" data-fit><span>{site.logo.text}</span></p>}

    <div class="site-footer__bottom t-meta">
      <span>© {year} {site.legalName}</span>
      <LiveStatus />
      <ul role="list">
        {navigation.legal.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        <li><a class="site-footer__top-link" href="#main">Back to top <Arrow direction="up" /></a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--section-m);
    padding-bottom: var(--s-6);
    border-top: 1px solid var(--border);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--s-7) var(--gutter);
    padding-bottom: var(--section-s);
  }

  .site-footer__brand {
    display: grid;
    align-content: start;
    gap: var(--s-5);
  }

  .site-footer__line {
    max-width: 18ch;
  }

  .site-footer__col {
    display: grid;
    align-content: start;
    gap: var(--s-4);
    font-size: var(--fs-small);
    font-style: normal;
  }

  .site-footer__col ul {
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  address {
    font-style: normal;
    line-height: 1.6;
  }

  .site-footer__col > a {
    justify-self: start;
  }

  /* Closing signature: the wordmark at full width. */
  .site-footer__mark {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    letter-spacing: -0.05em;
    text-transform: uppercase;
    font-size: clamp(3.5rem, -0.5rem + 17vw, 20rem);
    line-height: 0.78;
    white-space: nowrap;
    margin: 0 0 var(--s-6);
    overflow: hidden;
  }

  .site-footer__mark span {
    display: inline-block;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
  }

  .site-footer__bottom ul {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .site-footer__top-link:hover :global(.arrow) {
    transform: translateX(4px);
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .site-footer__top-link :global(.arrow) {
    color: var(--accent-ink);
  }

  @media (max-width: 63.99rem) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 29.99rem) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Fit the wordmark to the exact width of its container, whatever the brand name.
  document.querySelectorAll<HTMLElement>('[data-fit]').forEach((el) => {
    const span = el.firstElementChild as HTMLElement;
    let lastWidth = 0;
    const fit = () => {
      if (el.clientWidth === lastWidth && el.style.fontSize) return;
      lastWidth = el.clientWidth;
      el.style.fontSize = '100px';
      const ratio = el.clientWidth / span.getBoundingClientRect().width;
      el.style.fontSize = `${Math.floor(100 * ratio * 0.995)}px`;
    };
    document.fonts?.ready.then(() => {
      lastWidth = 0;
      fit();
    });
    fit();
    new ResizeObserver(fit).observe(el);
  });
</script>
