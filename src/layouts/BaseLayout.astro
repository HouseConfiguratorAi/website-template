---
import '@/styles/global.css';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-standard-normal.woff2?url';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import monoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import { site } from '@/config/site';
import { resolveTheme, themeToCss } from '@/config/theme';
import { resolveMedia } from '@/lib/media';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Cursor from '@/components/ui/Cursor.astro';
import MobileDock from '@/components/layout/MobileDock.astro';

interface Props {
  title?: string;
  description?: string;
  /** Media key or URL for the social image. */
  image?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Hide the footer's closing border, e.g. when the page ends on a full-bleed scene. */
  bareFooter?: boolean;
  /** Show the quick-action bar on phones (off where a page has its own sticky actions). */
  dock?: boolean;
}

const { title, description = site.description, image = site.ogImage, type = 'website', jsonLd, noindex = false, dock = true } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.description.split('.')[0]}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const activeTheme = resolveTheme();
const theme = themeToCss(activeTheme);
const serifDisplay = activeTheme.type.display === 'serif';
const monoMeta = activeTheme.type.metaFont !== 'sans';

let ogImage: string | undefined;
const media = resolveMedia(image);
if (media?.type === 'local') {
  const og = await getImage({ src: media.meta, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
  ogImage = new URL(og.src, site.url).href;
} else if (media?.type === 'remote') {
  ogImage = media.src;
}

const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    inLanguage: site.lang,
  },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={activeTheme.dark.background} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type === 'product' ? 'website' : type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {serifDisplay && <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    {monoMeta && <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={theme}></style>
    <script is:inline>
      // Motion is opt-in: only when the visitor has not asked for reduced motion
      // and the page is not opened with ?motion=off (useful for reviews and QA).
      (function () {
        var off = /[?&]motion=off\b/.test(location.search) || matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.classList.add('js');
        if (!off) document.documentElement.classList.add('motion');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    {dock && <MobileDock />}
    <Cursor />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
